# Modelo de variaveis de ambiente do projeto.
# Copie para .env e preencha com seus valores reais: cp .env.example .env
# O arquivo .env nao deve ser versionado (ja esta no .gitignore).

# Parametros de deploy (referencia pessoal; nao sao lidos pela aplicacao)
REPO_URL=https://github.com/SEU_USUARIO/SEU_REPO.git
IP_PUBLICO=SEU_IP_PUBLICO
CAMINHO_CHAVE=/home/SEU_USUARIO/.ssh/chave_prototipo.pem

# Variaveis da aplicacao (lidas pelo Django; na EC2 vao no arquivo de ambiente do systemd)
DJANGO_DEBUG=False
# Liste os hosts separados por virgula (ex.: SEU_IP_PUBLICO,127.0.0.1).
# Enquanto for prototipo, '*' e aceitavel para evitar reconfigurar a cada troca de IP.
# Trocar por lista explicita ao ter dominio/IP fixo.
DJANGO_ALLOWED_HOSTS=SEU_IP_PUBLICO,127.0.0.1
DJANGO_SECRET_KEY=GERE_E_COLE_AQUI

# Criacao do superusuario (usado uma unica vez no deploy)
DJANGO_SUPERUSER_USERNAME=DEFINA_UM_USUARIO
DJANGO_SUPERUSER_EMAIL=seu@email.com
DJANGO_SUPERUSER_PASSWORD=DEFINA_UMA_SENHA_FORTE

# S3 (somente em producao; deixe USE_S3=False ou ausente em desenvolvimento)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Banco de dados (defina DB_HOST para usar PostgreSQL; ausente => SQLite)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=prototipo_db
DB_USER=prototipo
DB_PASSWORD=
DB_HOST=
DB_PORT=5432